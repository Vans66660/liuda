.explore { position: relative; width: 100%; overflow: hidden; background-color: #08090b; }
.scene { position: relative; width: 100%; overflow: hidden; }
.world { position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 0; }
.render-canvas { position: fixed; left: -10000px; top: 0; pointer-events: none; }
.top-controls { position: absolute; top: 15px; left: 14px; right: 14px; height: 44px; display: flex; justify-content: space-between; align-items: center; z-index: 12; }
.bottom-area { z-index: 20; }
.nearby-launcher { height: 44px; padding: 0 13px 0 8px; display: flex; align-items: center; border: 1px solid #353840; border-radius: 24px; background-color: #15171c; color: #f3f4f6; box-sizing: border-box; }
.brand-mark { width: 27px; height: 27px; border-radius: 9px; background-color: #000000; }
.nearby-title { margin-left: 8px; height: 42px; line-height: 42px; font-size: 13px; }
.nearby-chevron { margin-left: 9px; height: 42px; line-height: 38px; color: #a0a4ae; font-size: 13px; }
.more-control { width: 44px; height: 44px; display: flex; align-items: center; justify-content: center; border: 1px solid #e1e2df; border-radius: 50%; background-color: #fffefa; box-shadow: 0 2px 8px #17191e12; box-sizing: border-box; }
.menu-dot { width: 3px; height: 3px; margin: 0 2px; border-radius: 50%; background-color: #15171c; }
.scene-context { position: absolute; left: 15px; top: 67px; height: 22px; line-height: 22px; padding: 0 8px; border-radius: 7px; background-color: #fffefa; color: #626873; font-size: 10px; z-index: 11; }
.map-notice { position: absolute; top: 68px; left: 14px; right: 14px; min-height: 34px; padding: 7px 11px; line-height: 19px; white-space: normal; border: 1px solid #e7dcc7; border-radius: 11px; background-color: #fff9ec; color: #76562b; font-size: 11px; box-sizing: border-box; z-index: 13; }
.notice-below-context { top: 98px; }
.look-hint { position: absolute; top: 105px; left: 50%; transform: translateX(-50%); height: 24px; line-height: 24px; font-size: 11px; color: #c9cdd5; padding: 0 10px; border-radius: 12px; background-color: #15171c; box-sizing: border-box; z-index: 10; }
/* Bottom overlays leave room for the map provider's native attribution. */
.bottom-area { position: absolute; left: 10px; right: 10px; bottom: 30px; }
.recenter-control { position: absolute; right: 15px; bottom: 44px; width: 46px; height: 46px; display: flex; align-items: center; justify-content: center; border: 1px solid #e1e2df; border-radius: 50%; background-color: #fffefa; box-shadow: 0 2px 8px #17191e12; box-sizing: border-box; z-index: 12; }
.recenter-raised { bottom: 104px; }
.locator-ring { width: 19px; height: 19px; display: flex; align-items: center; justify-content: center; border: 1.5px solid #878d98; border-radius: 50%; box-sizing: border-box; }
.locator-dot { width: 5px; height: 5px; border-radius: 50%; background-color: #878d98; }
.recenter-following .locator-ring { border-color: #15171c; }
.recenter-following .locator-dot { background-color: #15171c; }
.content-card { background-color: #15171c; border-radius: 24px; padding: 8px 18px 12px; box-sizing: border-box; }
.card-top { display: flex; align-items: center; height: 36px; }
.card-origin, .card-distance { height: 36px; line-height: 36px; color: #a0a4ae; font-size: 11px; }
.card-context-dot { height: 36px; line-height: 36px; margin: 0 7px; color: #666c78; font-size: 11px; }
.close-card { width: 44px; height: 36px; line-height: 34px; margin-right: -10px; text-align: center; color: #a0a4ae; font-size: 25px; flex-shrink: 0; }
.card-meta { display: flex; align-items: center; justify-content: space-between; height: 28px; font-size: 14px; line-height: 28px; }
.place-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; height: 28px; line-height: 28px; color: #e2e4e9; font-weight: 500; }
.status { height: 24px; padding: 0 8px; border-radius: 8px; color: #b8bdc8; background-color: #22242a; font-size: 11px; line-height: 24px; margin-left: 12px; flex-shrink: 0; }
.card-scroll { max-height: 240px; overflow-y: scroll; }
.card-copy { font-size: 18px; font-weight: 500; line-height: 28px; white-space: pre-wrap; margin: 12px 0 16px; word-break: break-all; }
.card-photo { width: 100%; height: 110px; border-radius: 10px; margin-bottom: 10px; }
.card-actions { display: flex; align-items: center; height: 44px; }
.reaction { min-width: 44px; height: 44px; line-height: 44px; color: #a0a4ae; font-size: 13px; flex-shrink: 0; }
.reply-count { margin-left: 8px; font-size: 12px; }
.liked { color: #e2e4e9; }
.actions-space { flex: 1; }
.expand { min-width: 40px; text-align: center; color: #a0a4ae; font-size: 12px; line-height: 44px; height: 44px; margin-left: 4px; flex-shrink: 0; }
.reply-button { height: 40px; margin-left: 10px; padding: 0 14px; line-height: 40px; text-align: center; background-color: #eceef2; color: #111216; border-radius: 13px; font-size: 13px; box-sizing: border-box; flex-shrink: 0; }
.mini-reply { padding: 10px 0; }
.reply-author { color: #a0a4ae; font-size: 11px; line-height: 18px; }
.reply-copy { font-size: 13px; line-height: 21px; white-space: normal; }
.text-action { color: #e2e4e9; font-size: 12px; line-height: 40px; height: 40px; }
.walk-control { position: absolute; bottom: 0; left: 0; right: 0; height: 42px; padding: 0 18px; display: flex; align-items: center; background: #15171c; font-size: 11px; color: #a0a4ae; box-sizing: border-box; }
.walk-slider { flex: 1; margin: 0 12px; }
.walk-value { width: 34px; text-align: right; }
.empty-prompt { padding: 13px; background-color: #15171c; border-radius: 15px; font-size: 13px; line-height: 22px; text-align: center; color: #e2e4e9; white-space: normal; }
.waiting { position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 20px; background: #08090b; }
.waiting > text { margin-bottom: 12px; }
.waiting-title { font-size: 20px; }
.waiting button { padding: 0 20px; }

/* 原生覆盖组件使用明确的色值，保证地图和街景上的前景可读。 */
.content-card { color: #f3f4f6; background-color: #15171c; border: 1px solid #292d35; }
.reply-button { background-color: #eceef2; color: #111216; }
.reaction.liked { color: #ffffff; }
.walk-control { background: #08090b; border-top: 1px solid #272a31; }
.empty-prompt { border: 1px solid #3b3e46; }
/* Use a filled line, not a partial border on the native cover-view. */
.card-footer { margin-top: 10px; }
.card-divider { display: block; width: 100%; height: 1px; background-color: #2c2f36; }
.footer-actions { display: flex; align-items: center; height: 44px; padding-top: 4px; }
.card-link { height: 40px; line-height: 40px; color: #aeb3be; font-size: 12px; flex-shrink: 0; }
.leave-link { padding-right: 8px; }
.next-link { width: 36px; height: 36px; line-height: 34px; margin-left: 8px; text-align: center; background-color: #22242a; border-radius: 10px; font-size: 20px; }
.waiting { box-sizing:border-box; }
.comma-pin { position:absolute; transform:translate(-50%,-50%); z-index:10; }
.comma-image { display:block; }
/* Nearby sheet: quiet shell, inset entries, a single reading hierarchy. */
.point-sheet { padding: 0 14px 14px; border: 1px solid #2b2e37; border-radius: 26px; color: #f3f4f6; background-color: #111318; }
.sheet-header { display: flex; align-items: center; height: 64px; padding: 4px 2px 0 6px; }
.sheet-heading { flex: 1; min-width: 0; max-height: 52px; overflow: hidden; white-space: normal; word-break: break-all; line-height: 26px; font-size: 21px; font-weight: 600; }
.sheet-close { display: flex; align-items: center; justify-content: center; width: 44px; height: 44px; margin-left: 8px; margin-right: -6px; flex-shrink: 0; }
.sheet-close-glyph { width: 30px; height: 30px; line-height: 28px; text-align: center; border-radius: 15px; background-color: #252830; color: #b4bac5; font-size: 23px; }
.sheet-toolbar { display: flex; align-items: center; height: 48px; padding: 0 4px 8px 6px; }
.sheet-subtitle { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #979eab; font-size: 12px; height: 24px; line-height: 24px; }
.sheet-segments { display: flex; align-items: center; height: 36px; padding: 3px; margin-left: 12px; border-radius: 12px; background-color: #090b0f; flex-shrink: 0; }
.sheet-sort { width: 50px; height: 30px; line-height: 30px; text-align: center; border-radius: 9px; font-size: 12px; color: #8d95a3; }
.sheet-sort-active { background-color: #30343d; color: #f3f4f6; }
.sheet-scroll { overflow-y: scroll; }
.sheet-row { padding: 14px 14px 13px; margin-bottom: 10px; border: 0; border-radius: 18px; background-color: #1d2027; }
.sheet-row-top { display: flex; align-items: center; height: 20px; }
.sheet-origin { padding: 0 5px; margin-right: 6px; height: 18px; line-height: 18px; border-radius: 5px; background-color: #353a45; color: #d2d7e0; font-size: 10px; flex-shrink: 0; }
.sheet-place { flex: 1; min-width: 0; font-size: 12px; color: #aeb5c2; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; height: 20px; line-height: 20px; }
.sheet-distance { margin-left: 10px; color: #8f98a7; font-size: 12px; height: 20px; line-height: 20px; flex-shrink: 0; }
.sheet-copy { margin: 10px 0 12px; color: #f0f2f6; font-size: 17px; font-weight: 500; line-height: 26px; max-height: 52px; overflow: hidden; white-space: normal; word-break: break-all; }
.sheet-row-bottom { height: 28px; display: flex; align-items: center; }
.sheet-counts { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-size: 12px; color: #929baa; height: 24px; line-height: 24px; }
.sheet-tag { margin-left: 8px; padding: 0 6px; height: 20px; line-height: 20px; border-radius: 6px; font-size: 10px; color: #d3d8e1; background-color: #323843; flex-shrink: 0; }
.sheet-access { margin-left: 10px; height: 24px; line-height: 24px; color: #c6cdd9; font-size: 12px; flex-shrink: 0; }
.sheet-open { width: 26px; height: 26px; margin-left: 8px; line-height: 24px; text-align: center; font-size: 22px; color: #cbd2df; background-color: #2b303a; border-radius: 13px; flex-shrink: 0; }
.sheet-empty { padding: 22px 14px 28px; text-align: center; }
.sheet-empty-mark { display: block; width: 44px; height: 44px; margin: 0 auto 12px; border-radius: 14px; }
.sheet-empty-title { color: #d5dae4; font-size: 15px; line-height: 24px; height: 24px; }
.sheet-empty-copy { margin-top: 8px; color: #858f9f; font-size: 12px; line-height: 20px; white-space: normal; }
.card-heat { margin-left: 10px; font-size: 10px; color: #cdd0d7; height: 20px; line-height: 20px; }
.group-link { padding: 0 8px; }
.campus-world { background-color:#243b47;overflow:hidden; }
.campus-tile { position:absolute;left:0;top:0;transform-origin:0 0;pointer-events:none; }
.campus-label { position:absolute;transform:translate(-50%,-50%);padding:3px 5px;line-height:14px;white-space:nowrap;color:#253c43;background-color:#e7d6b2;pointer-events:none;z-index:2; }
.campus-draft { color:#d0d4c8;background-color:#30494e; }
.campus-accuracy { position:absolute;border:1px solid #7db3d766;background-color:#77b7e217;border-radius:50%;pointer-events:none;box-sizing:border-box;z-index:2; }
.campus-pin { position:absolute;z-index:3; }
.campus-pin image { display:block; }
.campus-user { position:absolute;width:18px;height:18px;border:3px solid #f3f8fc;border-radius:50%;background-color:#66b7eb;box-shadow:0 0 0 4px #66b7eb22;transform:translate(-50%,-50%);box-sizing:border-box;pointer-events:none;z-index:4; }
.campus-user-stale { opacity:.45; }
.campus-scale { position:absolute;left:16px;bottom:14px;color:#ded8c3;font-size:9px;line-height:14px;pointer-events:none;z-index:5; }
.campus-scale-line { border-bottom:1.5px solid #dcd6be;height:4px;margin-bottom:2px; }
.campus-attribution { position:absolute;right:8px;bottom:5px;padding:3px 5px;line-height:13px;font-size:8px;color:#e1dfd0;background-color:#243b47;z-index:11; }

@media (max-width: 350px) {
  .content-card { padding-left: 14px; padding-right: 14px; border-radius: 22px; }
  .reply-button { margin-left: 6px; padding: 0 12px; }
  .card-copy { font-size: 17px; line-height: 27px; }
  .point-sheet { padding-left: 12px; padding-right: 12px; border-radius: 23px; }
  .sheet-heading { font-size: 20px; }
  .sheet-header { padding-left: 4px; }
  .sheet-toolbar { padding-left: 4px; }
  .sheet-segments { margin-left: 8px; }
  .sheet-sort { width: 44px; }
  .sheet-row { padding-left: 12px; padding-right: 12px; border-radius: 16px; }
  .sheet-copy { font-size: 16px; }
  .sheet-distance { margin-left: 8px; }
  .sheet-access { margin-left: 8px; }
  .sheet-tag { margin-left: 6px; padding: 0 5px; }
}
