<template name="scene-ui">
  <cover-view class="top-controls">
    <cover-view class="nearby-launcher" bindtap="chooseNearby" aria-role="button" aria-label="查看附近留话"><cover-image class="brand-mark" src="/assets/brand/liuda-comma.png" /><cover-view class="nearby-title">{{nearbyLabel}}</cover-view><cover-view class="nearby-chevron">⌄</cover-view></cover-view>
    <cover-view class="more-control" bindtap="more" aria-role="button" aria-label="更多地图选项"><cover-view class="menu-dot"></cover-view><cover-view class="menu-dot"></cover-view><cover-view class="menu-dot"></cover-view></cover-view>
  </cover-view>
  <cover-view wx:if="{{sceneContext}}" class="scene-context">{{sceneContext}}</cover-view>
  <cover-view wx:if="{{mapNotice}}" class="map-notice {{sceneContext ? 'notice-below-context' : ''}}" bindtap="noticeAction" aria-role="button" aria-label="{{mapNotice}}">{{mapNotice}}</cover-view>
  <block wx:if="{{view === 'street'}}"><block wx:for="{{pins}}" wx:key="id"><cover-view class="comma-pin" style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.width}}px;height:{{item.height}}px" data-id="{{item.id}}" catchtap="selectPin" aria-role="button" aria-label="{{item.count}}条留话，{{item.heatLabel}}"><cover-image class="comma-image" src="{{item.iconPath}}" style="width:{{item.width}}px;height:{{item.height}}px" /></cover-view></block></block>
  <cover-view wx:if="{{view === 'street' && lookHint && !mapNotice}}" class="look-hint">左右拖动看看</cover-view>
  <cover-view wx:if="{{mode === 'live' && !sheetVisible && !(selected && cardVisible)}}" class="recenter-control {{!nearbyCount || !cloudConnected ? 'recenter-raised' : ''}} {{following ? 'recenter-following' : ''}}" bindtap="recenter" aria-role="button" aria-label="回到我的位置"><cover-view class="locator-ring"><cover-view class="locator-dot"></cover-view></cover-view></cover-view>
  <cover-view class="bottom-area">
    <cover-view wx:if="{{mode === 'live' && !sheetVisible && (!cardVisible || !selected) && (!nearbyCount || !cloudConnected)}}" class="empty-prompt" bindtap="emptyAction">{{emptyLabel}}</cover-view>
    <cover-view wx:if="{{sheetVisible}}" class="point-sheet" catchtap="stopTap">
      <cover-view class="sheet-header"><cover-view class="sheet-heading">{{sheetTitle}}</cover-view><cover-view class="sheet-close" bindtap="closeSheet" aria-role="button" aria-label="关闭列表">×</cover-view></cover-view>
      <cover-view class="sheet-toolbar"><cover-view class="sheet-subtitle">{{sheetSubtitle}}</cover-view><cover-view class="sheet-sort {{sheetSort === 'heat' ? 'sheet-sort-active' : ''}}" data-sort="heat" bindtap="sortSheet">推荐</cover-view><cover-view class="sheet-sort {{sheetSort === 'latest' ? 'sheet-sort-active' : ''}}" data-sort="latest" bindtap="sortSheet">最新</cover-view></cover-view>
      <cover-view class="sheet-scroll" style="max-height:{{sheetMaxHeight}}px">
        <cover-view wx:for="{{sheetRows}}" wx:key="id" class="sheet-row" data-id="{{item.id}}" bindtap="selectSheetPost" aria-role="button">
          <cover-view class="sheet-row-top"><cover-view class="sheet-place">{{item.owned ? '我 · ' : ''}}{{item.name}}</cover-view><cover-view class="sheet-distance">{{item.distanceLabel}}</cover-view></cover-view>
          <cover-view class="sheet-copy">{{item.copy}}</cover-view>
          <cover-view class="sheet-row-bottom"><cover-view class="sheet-tag tag-{{item.tier}}">{{item.tag}}</cover-view><cover-view class="sheet-counts">♡ {{item.likes}} · 接话 {{item.commentCount}}</cover-view><cover-view class="actions-space"></cover-view><cover-view class="sheet-access">{{item.access}} →</cover-view></cover-view>
        </cover-view>
        <cover-view wx:if="{{!sheetRows.length}}" class="sheet-empty">这里暂时没有可显示的留话。</cover-view>
      </cover-view>
    </cover-view>
    <cover-view wx:if="{{selected && cardVisible && !sheetVisible}}" class="content-card">
      <cover-view class="card-top"><cover-view class="card-heat">{{selectedHeatLabel}}</cover-view><cover-view class="handle" bindtap="expand"><cover-view class="handle-line"></cover-view></cover-view><cover-view class="close-card" bindtap="closeCard" aria-role="button" aria-label="关闭留言">×</cover-view></cover-view>
      <cover-view class="card-meta"><cover-view class="place-name">{{selected.owned ? '我留下的 · ' : ''}}{{selected.name}}</cover-view><cover-view class="status">{{selected.participated || selected.owned ? '可续聊' : selected.canReply ? '可接话' : selected.level === 'full' ? '已走近' : '走近看看'}} · {{selected.distanceLabel}}</cover-view></cover-view>
      <cover-view class="card-scroll" style="max-height:{{cardMaxHeight}}px">
        <cover-view class="card-copy">{{selected.displayText}}</cover-view>
        <cover-image wx:if="{{selected.level === 'full' && selected.photoPath}}" class="card-photo" src="{{selected.photoPath}}" bindtap="openThread" />
        <cover-view wx:if="{{expanded && selected.level === 'full'}}" class="mini-replies"><cover-view wx:for="{{selected.previewComments}}" wx:key="id" class="mini-reply"><cover-view class="reply-author">{{item.name}}</cover-view><cover-view class="reply-copy">{{item.text}}</cover-view></cover-view><cover-view class="text-action" bindtap="openThread" aria-role="button">查看完整对话 →</cover-view></cover-view>
      </cover-view>
      <cover-view class="card-actions"><cover-view class="reaction {{selected.liked ? 'liked' : ''}}" bindtap="like" aria-role="button">{{selected.liked ? '♥' : '♡'}} {{selected.likes}}</cover-view><cover-view class="reaction reply-count" bindtap="openThread" aria-role="button">◌ {{selected.commentCount}}</cover-view><cover-view class="actions-space"></cover-view><cover-view wx:if="{{selected.level === 'full'}}" class="expand" bindtap="expand" aria-role="button">{{expanded ? '收起' : '展开'}} {{expanded ? '⌄' : '⌃'}}</cover-view><cover-view class="reply-button" bindtap="openThread" aria-role="button">{{selected.participated || selected.owned ? '继续聊' : selected.canReply ? '接一句' : '走近看看'}}</cover-view></cover-view>
      <cover-view wx:if="{{selected.canInteract || nearbyCount > 1}}" class="card-footer"><cover-view wx:if="{{selected.canInteract}}" class="card-link" bindtap="leaveHere" aria-role="button">在此再留一句 ＋</cover-view><cover-view class="actions-space"></cover-view><cover-view wx:if="{{selectedGroupCount > 1}}" class="card-link group-link" bindtap="selectedGroup" aria-role="button">这组 {{selectedGroupCount}} 条</cover-view><cover-view wx:if="{{nearbyCount > 1}}" class="card-link" bindtap="nextPost" aria-role="button">下一条 →</cover-view></cover-view>
    </cover-view>
  </cover-view>
</template>
<view class="explore" style="height:{{stageHeight}}px">
  <view wx:if="{{!privacyVisible}}" class="scene" style="height:{{canvasHeight}}px">
    <canvas wx:if="{{view === 'street' && hasPosition}}" type="2d" id="street" class="render-canvas" style="width:{{sceneWidth}}px;height:{{canvasHeight}}px"></canvas>
    <image wx:if="{{view === 'street' && hasPosition}}" class="world" src="{{sceneFrame}}" mode="scaleToFill" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel" aria-label="虚拟街区，可左右拖动视角" />
    <map wx:if="{{mode === 'live' && view === 'map' && hasPosition}}" id="real-map" class="world" latitude="{{latitude}}" longitude="{{longitude}}" scale="{{mapScale}}" min-scale="14" max-scale="20" enable-rotate="{{false}}" enable-overlooking="{{false}}" show-location="{{false}}" enable-poi="{{true}}" markers="{{markers}}" circles="{{circles}}" bindmarkertap="selectMarker" bindcallouttap="selectMarker" bindtap="mapTap" bindregionchange="mapChange"></map>
    <view wx:if="{{mode === 'live' && view === 'campus'}}" class="world campus-world" bindtouchstart="touchStart" catchtouchmove="touchMove" bindtouchend="touchEnd" bindtouchcancel="touchCancel" bindtap="campusTap" aria-label="贸大夜游地图，可拖动及双指缩放">
      <image class="campus-tile" src="/assets/campus/uibe-night.jpg" style="width:{{campusWidth}}px;height:{{campusHeight}}px;transform:{{campusFrame.transform}}" mode="scaleToFill" binderror="campusImageError" />
      <view wx:for="{{campusFrame.labels}}" wx:key="id" class="campus-label {{item.draft ? 'campus-draft' : ''}}" style="left:{{item.x}}px;top:{{item.y}}px;font-size:{{item.font}}px">{{item.name}}</view>
      <view wx:if="{{campusFrame.user && campusFrame.user.radius}}" class="campus-accuracy" style="left:{{campusFrame.user.x-campusFrame.user.radius}}px;top:{{campusFrame.user.y-campusFrame.user.radius}}px;width:{{campusFrame.user.radius*2}}px;height:{{campusFrame.user.radius*2}}px"></view>
      <view wx:for="{{campusFrame.pins}}" wx:key="id" class="campus-pin" style="left:{{item.x}}px;top:{{item.y}}px;width:{{item.width}}px;height:{{item.height}}px" data-id="{{item.id}}" catchtap="selectCampusPin" aria-role="button" aria-label="{{item.count}}条留话"><image src="{{item.iconPath}}" style="width:{{item.width}}px;height:{{item.height}}px" /></view>
      <view wx:if="{{campusFrame.user}}" class="campus-user {{campusFrame.user.fresh ? '' : 'campus-user-stale'}}" style="left:{{campusFrame.user.x}}px;top:{{campusFrame.user.y}}px"></view>
      <view class="campus-scale"><view class="campus-scale-line" style="width:{{campusFrame.scaleWidth}}px"></view><text>{{campusFrame.scaleText}}</text></view>
    </view>
    <cover-view wx:if="{{view === 'campus'}}" class="campus-attribution" bindtap="campusInfo" aria-role="button" aria-label="校园底图来源与精度说明">© OpenStreetMap contributors · ODbL</cover-view>
    <block wx:if="{{hasPosition || view === 'campus'}}"><template is="scene-ui" data="{{mode,view,sceneContext,mapNotice,pins,lookHint,posts,cardVisible,selected,expanded,cloudConnected,following,emptyLabel,nearbyLabel,nearbyCount,cardMaxHeight,sheetVisible,sheetTitle,sheetSubtitle,sheetRows,sheetSort,sheetMaxHeight,selectedGroupCount,selectedHeatLabel}}" /></block>
    <view wx:if="{{!hasPosition && view !== 'campus'}}" class="waiting"><image class="empty-mascot" src="/assets/brand/liuda-comma.png" mode="aspectFit" /><text class="waiting-title">先找到你的位置</text><text class="muted">在手机上开启定位，就能看看附近。</text><button class="primary" bindtap="recenter">开启定位</button><button class="text-button" bindtap="locationDetails">查看定位原因</button><button class="text-button" bindtap="openCampus">先看看贸大校园</button><button class="text-button" bindtap="chooseMode">切回演示模式</button></view>
  </view>
  <view wx:if="{{mode === 'demo'}}" class="walk-control"><text class="walk-label">模拟步行</text><slider class="walk-slider" min="0" max="160" step="2" value="{{walk}}" bindchanging="walk" bindchange="walk" activeColor="#e9ebef" backgroundColor="#353840" block-color="#f3f4f6" block-size="16" /><text class="walk-value">{{walk}}m</text></view>
</view>
<privacy-gate bindvisibilitychange="privacyVisibility" />
