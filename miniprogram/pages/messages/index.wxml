<view class="page">
  <view class="row"><view class="brand-row"><image class="brand-avatar" src="/assets/brand/liuda-comma.png" mode="aspectFit" aria-label="留答" /><text class="title">路过的痕迹</text></view><button class="text-button" bindtap="load" loading="{{loading}}" disabled="{{loading}}">刷新</button></view>
  <view class="row history-meta"><text class="muted">参与 {{threads.length}} 段对话 · 近期回应 {{replies}}</text><text class="badge">{{mode === 'demo' ? '演示' : '可续聊'}}</text></view>
  <text class="history-intro">在现场开始的对话，离开后也能接着聊。</text>
  <view class="history-tabs"><button class="history-tab {{section === 'joined' ? 'history-tab-active' : ''}}" data-section="joined" bindtap="switchSection">我参与的</button><button class="history-tab {{section === 'mine' ? 'history-tab-active' : ''}}" data-section="mine" bindtap="switchSection">我留下的</button><button class="history-tab {{section === 'replies' ? 'history-tab-active' : ''}}" data-section="replies" bindtap="switchSection">回应 {{events.length}}</button></view>
  <view wx:if="{{error}}" class="card message-status"><text class="card-title">暂未刷新</text><text class="muted">{{error}}</text><button wx:if="{{needsJoin}}" class="secondary" bindtap="connect">加入现场留话</button><button wx:else class="secondary" bindtap="load" disabled="{{loading}}">重试</button></view>
  <block wx:if="{{section === 'joined'}}">
    <view wx:for="{{threads}}" wx:key="id" class="card local-post" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="card-title">{{item.name}}</text><text class="muted">→</text></view><view class="row post-foot"><text class="muted">{{item.owned ? '我留下的' : '我接过话'}} · {{item.commentCount}} 句回复</text><text class="muted">{{item.timeLabel}}</text></view><text class="continue-label">继续这段对话 →</text></view>
    <view wx:if="{{!threads.length && !error}}" class="card message-status empty-message"><image class="empty-mascot" src="/assets/brand/liuda-comma.png" mode="aspectFit" /><text class="card-title">{{loading ? '正在找你的对话…' : '先去现场接一句'}}</text><text class="muted">在现场留一句，或接上别人的话，就能在这里继续。</text><button wx:if="{{!loading}}" class="primary" bindtap="nearby">去附近看看</button></view>
  </block>
  <block wx:elif="{{section === 'mine'}}">
    <view wx:for="{{posts}}" wx:key="id" class="card local-post" data-id="{{item.id}}" bindtap="open"><view class="row"><text class="card-title">{{item.name}}</text><text class="muted">→</text></view><view class="row post-foot"><text class="muted">{{item.commentCount}} 句回复 · 离场可继续</text><text class="muted">{{item.timeLabel}}</text></view></view>
    <view wx:if="{{!posts.length && !error}}" class="card message-status empty-message"><image class="empty-mascot" src="/assets/brand/liuda-comma.png" mode="aspectFit" /><text class="card-title">{{loading ? '正在找你的留话…' : '把第一句话留在这里'}}</text><text class="muted">给眼前的地点留个提醒、问题或玩笑。</text><button wx:if="{{!loading}}" class="primary" bindtap="compose">去留一句</button></view>
  </block>
  <block wx:else>
    <view wx:for="{{events}}" wx:key="id" class="card local-post" data-id="{{item.postId}}" bindtap="open"><text class="card-title">你参与的对话，有人接上了</text><view class="row post-foot"><text class="muted">{{item.name}} →</text><text class="muted">{{item.timeLabel}}</text></view></view>
    <view wx:if="{{!events.length && !error}}" class="card message-status empty-message"><image class="empty-mascot" src="/assets/brand/liuda-comma.png" mode="aspectFit" /><text class="card-title">{{loading ? '正在同步…' : '等一个路过的回应'}}</text><text class="muted">{{mode === 'demo' ? '演示区由你一个人操作，不会模拟他人的回应。' : '别人接上你参与过的对话时，会出现在这里，离场也能查看。'}}</text><button wx:if="{{!loading}}" class="secondary" bindtap="nearby">去附近看看</button></view>
  </block>
  <button class="text-button" bindtap="about">关于留答</button>
</view>
