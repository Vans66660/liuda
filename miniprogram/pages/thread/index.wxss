.post-card { margin-top: 30rpx; }
.post-actions { margin-top: 18rpx; border-top: 1rpx solid #30333b; }
.comment { padding: 24rpx 8rpx; border-bottom: 1rpx solid #30333b; }
.comment .body { margin-top: 8rpx; font-size: 29rpx; }
.reply-box { margin-top: 34rpx; }
.reply-box textarea { min-height: 170rpx; font-size: 29rpx; }
.reply-box .row { margin-top: 12rpx; }
.reply-box button { padding: 0 30rpx; margin: 0; }
.delete-button { background: transparent; color: #dfa5a5; font-size: 24rpx; }
.thread-refresh { min-height:56rpx; line-height:56rpx; font-size:24rpx; }
.thread-time { display:block; margin-top:8rpx; font-size:22rpx; }
.continuation-note { margin-top:24rpx; padding:20rpx 24rpx; background:#1c2521; color:#bcd0c2; border-radius:18rpx; font-size:24rpx; line-height:1.7; }
.continuation-tag { margin-left:16rpx; padding:3rpx 12rpx; border-radius:8rpx; color:#bcd0c2; background:#1c2521; font-size:20rpx; }
.like-onsite { font-size:21rpx; margin-right:18rpx; }
