{
  "expo": {
    "name": "留答",
    "slug": "liuda-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/liuda-comma.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101215",
        "foregroundImage": "./assets/liuda-comma.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/liuda-comma.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "选择照片以设置你的留答头像。",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "scheme": "liuda"
  }
}
