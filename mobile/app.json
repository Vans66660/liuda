{
  "expo": {
    "name": "留答",
    "slug": "liuda-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/liuda-comma.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
