{
  "expo": {
    "name": "留答",
    "slug": "liuda-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/liuda-comma.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#101215",
        "foregroundImage": "./assets/liuda-comma.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "server",
      "favicon": "./assets/liuda-comma.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      ["expo-camera", { "cameraPermission": "允许留答拍摄现场照片。", "recordAudioAndroid": false }],
      ["expo-audio", { "microphonePermission": "允许留答录制现场语音。" }],
      [
        "expo-image-picker",
        {
          "photosPermission": "选择照片以设置你的留答头像。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "允许留答使用你的位置，以记录现场留话地点并显示与你的距离。"
        }
      ]
    ],
    "scheme": "liuda"
  }
}
